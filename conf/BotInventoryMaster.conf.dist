[worldserver]
# Bot Inventory Master
#

# Enable the module.
# Default: 1
BotInventoryMaster.Enable = 1

# Require the target bot/alt to be on the same account as the manager.
# Account-linking is table-ready but commands are not enabled yet.
# Default: 1
BotInventoryMaster.RequireSameAccount = 1

# Allow GM accounts to bypass account ownership checks.
# Default: 1
BotInventoryMaster.GMBypass = 1

# Require the target to be a bot session.
# Leave 0 for now because playerbot session reporting can vary between forks/modules.
# Default: 0
BotInventoryMaster.RequireTargetIsBot = 0

# Enable reagent deposit from managed bots into this module's virtual account bank.
# Default: 1
BotInventoryMaster.DepositReagents.Enable = 1

# Limit rows shown by .botinv bank.
# Default: 80
BotInventoryMaster.MaxBankListRows = 80

# Required distance between manager/bot/vendor for trade-like actions.
# Used by take and vendor sell commands.
# Default: 12
BotInventoryMaster.RequiredTradeDistance = 12


#
# Vendor safety additions
#

# Allows selling one selected non-gray item to the selected vendor with confirm.
# Quest items, bags/containers, and no-sell-price items remain blocked.
BotInventoryMaster.Vendor.AllowSellSelected = 1

# In-memory module buyback for items sold through BotInventoryMaster.
# This restores entry/count only; enchants/gems/random properties are not preserved.
BotInventoryMaster.Vendor.AllowBuyback = 1
BotInventoryMaster.Vendor.BuybackMaxRecordsPerBot = 12


#
# Danger mode / no-warning item control
#
# Single-player convenience mode. Lets BotInventoryMaster sell/destroy any bag item,
# including white/green/blue items, bags/containers, and quest items.
# Use with care: destroying a bag may destroy its contents.
BotInventoryMaster.Danger.AllowAnySell = 1
BotInventoryMaster.Danger.AllowAnyDestroy = 1

# If 0, selected sell/destroy commands do not require the literal "confirm" word.
# The addon still sends direct actions; no popup warnings.
BotInventoryMaster.Danger.RequireConfirm = 0


#
# Bulk cleanup guardrails
#
# Multi-select sell/delete is intentionally safer than single-item Danger mode.
# 0=poor/gray, 1=common/white, 2=uncommon/green, 3=rare/blue, 4=epic/purple.
# Default 2 lets the addon bulk-clean gray/white/green clutter while protecting blue+ gear.
BotInventoryMaster.Bulk.MaxQuality = 2

# Hard cap per one chat command. The addon automatically chunks larger selections.
# Keep <=24 so commands remain safely below the WoW 3.3.5 chat-length limit.
BotInventoryMaster.Bulk.MaxItemsPerCommand = 24

# Bulk actions always protect quest items, bags/containers, Hearthstone, Shaman totems,
# no-user-destroy items, key/quest-family items, and class/profession tools with a TotemCategory.
# They only accept normal backpack slots and contents of equipped inventory bags; equipment, bank,
# keyring, buyback, and other non-bag positions are rejected. Single-item Danger mode is unchanged.
